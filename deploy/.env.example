# Copy to .env on the VPS and run: chmod 600 .env
# Hostnames are derived from the VPS IPv4 address via sslip.io.
APP_HOST=app.1-2-3-4.sslip.io
API_HOST=api.1-2-3-4.sslip.io
IMAGES_HOST=images.1-2-3-4.sslip.io

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
RESTAURANT_DB_PASSWORD=change-me
IMAGES_DB_PASSWORD=change-me

# Image tags. Set to a commit SHA to roll back.
API_TAG=latest
IMAGES_TAG=latest
FRONTEND_TAG=latest
